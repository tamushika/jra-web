# jra-web/.env のひな形。実際の値は入れずに GitHub へ置く用。
# 使い方: このファイルを .env にコピーし、デスクトップ側の .env から値を写す。
# .env は .gitignore 済み (絶対にコミットしない)。

# Neon PostgreSQL の接続文字列。過去データ分析・トラックバイアス・週次登録で使う。
# 未設定でもアプリは起動するが、api/past_data_v2.db (ローカル 304MB) が必要になる。
DATABASE_URL=

# LINE Messaging API のチャネルトークン。EV 通知・WIN5 確信度通知の送信先。
# **空にすると LINE 通知は送られない** (ノート PC では空にするのを推奨)。
EV_LINE_CHANNEL_TOKEN=

# EV 通知の閾値 (既定 1.3)。シャドー実測用で購入推奨ではない。
EV_THRESHOLD=1.3

# 任意: Discord Webhook。空なら Discord 通知は送られない。
# EV_DISCORD_WEBHOOK=

# 任意: WIN5 の確信度 LINE 通知を止める場合は 0。
# WIN5_LINE_NOTIFY=1
